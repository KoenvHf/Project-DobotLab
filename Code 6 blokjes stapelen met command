# version: Python3
from DobotEDU import *
import time

# Pick-up positions
block_position = {
    "G": [(280.95, -30.00, -44.49), (299.39, -30.00, -44.49), (317.65, -30.00, -44.49), (336.00, -30.00, -44.49)],
    "B": [(280.95, -10.00, -44.49), (299.39, -10.00, -44.49), (317.65, -10.00, -44.49),	(336.00, -10.00, -44.49)],
    "Y": [(280.95, 10.00, -44.49), (299.39, 10.00, -44.49), (317.65, 10.00, -44.49), (336.00, 10.00, -44.49)],
    "R": [(280.95, 30.00, -44.49), (299.39, 30.00, -44.49), (317.65, 30.00, -44.49), (336.00, 30.00, -44.49)]
}

# Stack position
stack_x = 305.21
stack_y = 97.13
stack_heights_for_stacking = (-43.10, -32.10, -21.10, -10.10, 0.90, 11.90)
stack_heights_for_return = (15.59, 6.10, -6.34, -17.37, -29.87, -42.37)
movement_settle_time = 1
pickup_clearance = 20

def get_color_order():
    while True:
        order = input("Enter up to 6 blocks using G, B, Y and R").upper()
        valid_letters = all(color in "GBYR" for color in order)
        no_more_than_four = all(order.count(color) <= 4 for color in "GBYR")
        if 1 <= len(order) <= 6 and set(order) and valid_letters and no_more_than_four:
            return order
        print("Invalid order. Enter 1 to 6 blocks and use each color no more than twice.")

def wait_for_return_command():
    while True:
        command = input("Type R or RETURN to return the blocks: ").strip().upper()
        if command in ("R", "RETURN"):
            return
        print("Invalid command. Type R or RETURN.")

used_blocks = {"G" : 0, "B" : 0, "Y" : 0, "R" : 0} 

def pick_up_block(color, stack_level):
    block_number = used_blocks[color]
    pickup_x, pickup_y, pickup_z = block_position[color][block_number]
    stack_z = stack_heights_for_stacking[stack_level]
    used_blocks[color] += 1

    # Approach the block from above
    m_lite.set_homecmd()
    m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z + pickup_clearance, r=0)
    # Enable suction before descending onto the block.
    m_lite.set_endeffector_suctioncup(enable=True, on=True)
    m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z, r=0)

    # Lift the block before moving to the stack
    m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z + pickup_clearance, r=0)

    # Move above the stack, then descend to the stack level
    m_lite.set_homecmd()
    m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=stack_z + pickup_clearance, r=0)
    m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=stack_z, r=0)
    m_lite.set_endeffector_suctioncup(enable=True, on=False)

    return color, block_number, stack_z

def return_stacked_blocks(stacked_blocks):
    return_heights = stack_heights_for_return[-len(stacked_blocks):]
    for return_level, (color, block_number, stack_z) in enumerate(reversed(stacked_blocks)):
        pickup_x, pickup_y, pickup_z = block_position[color][block_number]
        return_stack_z = return_heights[return_level]

        # Move away from the previously released block with suction off.
        m_lite.set_endeffector_suctioncup(enable=True, on=False)
        m_lite.set_homecmd()
        m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=return_stack_z + pickup_clearance, r=0)
        time.sleep(movement_settle_time)
        # Enable suction above the stack block before descending.
        m_lite.set_endeffector_suctioncup(enable=True, on=True)
        m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=return_stack_z, r=0)
        time.sleep(movement_settle_time)
        time.sleep(1)

        # Lift the block before moving to its original position
        m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=return_stack_z + pickup_clearance, r=0)
        time.sleep(movement_settle_time)

        # Move above the original position, then descend to it
        m_lite.set_homecmd()
        m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z + pickup_clearance, r=0)
        time.sleep(movement_settle_time)
        m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z, r=0)
        time.sleep(movement_settle_time)
        m_lite.set_endeffector_suctioncup(enable=True, on=False)
        time.sleep(1)

order = get_color_order()

color_names = {
    "G": "Green",
    "B": "Blue",
    "Y": "Yellow",
    "R": "Red"
}

print("Stacking order from bottom to top...")

stacked_blocks = []
for stack_level, color in enumerate(order):
    print("Placing", color_names[color], "at level", stack_level + 1)
    stacked_blocks.append(pick_up_block(color, stack_level))

m_lite.set_homecmd()
print("Stacking complete.")

wait_for_return_command()
return_stacked_blocks(stacked_blocks)
m_lite.set_homecmd()
print("Blocks returned.")
