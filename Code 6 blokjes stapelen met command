# version: Python3
from DobotEDU import *

# Pick-up positions
block_position = {
    "G": [(280.95, -30.00, -42.38), (299.39, -30.00, -42.38), (317.65, -30.00, -42.38), (336.00, -30.00, -42.38)],
    "B": [(280.95, -10.00, -42.38), (299.39, -10.00, -42.38), (317.65, -10.00, -42.38),	(336.00, -10.00, -42.38)],
    "Y": [(280.95, 10.00, -42.38), (299.39, 10.00, -42.38), (317.65, 10.00, -42.38), (336.00, 10.00, -42.38)],
    "R": [(280.95, 30.00, -42.38), (299.39, 30.00, -42.38), (317.65, 30.00, -42.38), (336.00, 30.00, -42.38)]
}

# Stack position
stack_x = 305.21
stack_y = 97.13
stack_heights = (-43.10, -32.10, -21.10, -10.10, 0.90, 11.90, 22.90, 33.90)

def get_color_order():
    while True:
        order = input("Enter up to 6 blocks using G, B, Y and R").upper()
        valid_letters = all(color in "GBYR" for color in order)
        no_more_than_four = all(order.count(color) <= 4 for color in "GBYR")
        if 1 <= len(order) <= 6 and set(order) and valid_letters and no_more_than_four:
            return order
        print("Invalid order. Enter 1 to 6 blocks and use each color no more than twice.")

used_blocks = {"G" : 0, "B" : 0, "Y" : 0, "R" : 0} 

def pick_up_block(color, stack_level):
    block_number = used_blocks[color]
    pickup_x, pickup_y, pickup_z = block_position[color][block_number]
    stack_z = stack_heights[stack_level]
    used_blocks[color] += 1

    # Go to block
    m_lite.set_homecmd()
    m_lite.set_ptpcmd(ptp_mode=1, x=pickup_x, y=pickup_y, z=pickup_z, r=0)
    m_lite.set_endeffector_suctioncup(enable=True, on=True)

    # Move to stack
    m_lite.set_homecmd()
    m_lite.set_ptpcmd(ptp_mode=1, x=stack_x, y=stack_y, z=stack_z, r=0)
    m_lite.set_endeffector_suctioncup(enable=True, on=False)

order = get_color_order()

color_names = {
    "G": "Green",
    "B": "Blue",
    "Y": "Yellow",
    "R": "Red"
}

print("Stacking order from bottom to top...")

for stack_level, color in enumerate(order):
    print("Placing", color_names[color], "at level", stack_level + 1)
    pick_up_block(color, stack_level)

m_lite.set_homecmd()
print("Stacking complete.")
